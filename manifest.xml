<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="MailApp">

  <Id>b2c3d4e5-f6a7-8901-bcde-f23456789012</Id>
  <Version>1.0.0</Version>
  <ProviderName>Miller and Miller Law Group</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="M|M Time Tracker"/>
  <Description DefaultValue="Auto-track email time and bill to Lawmatics matters"/>
  <IconUrl DefaultValue="https://MMLawGroup.github.io/mm-time-tracker/icon.png"/>
  <HighResolutionIconUrl DefaultValue="https://MMLawGroup.github.io/mm-time-tracker/icon.png"/>
  <SupportUrl DefaultValue="https://github.com/MMLawGroup/mm-time-tracker"/>

  <AppDomains>
    <AppDomain>https://MMLawGroup.github.io</AppDomain>
    <AppDomain>https://app.lawmatics.com</AppDomain>
  </AppDomains>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://MMLawGroup.github.io/mm-time-tracker/taskpane.html"/>
        <RequestedHeight>380</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://MMLawGroup.github.io/mm-time-tracker/taskpane.html"/>
        <RequestedHeight>380</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

</OfficeApp>
